{
  "name": "td-admin",
  "version": "8.0.0",
  "homepage": "http://www.kavispires.com/td-admin/",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@google/generative-ai": "^0.24.1",
    "@microlink/react-json-view": "^1.31.30",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-store": "^0.11.1",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^6.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "lodash": "^4.18.1",
    "motion": "^13.1.1",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "react-swipeable": "^7.0.2",
    "react-use": "^17.6.1",
    "recharts": "^3.10.1",
    "sass": "^1.103.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-svgr": "^5.2.0",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "prepare": "husky",
    "sync:types": "curl -s -o src/types/tdr.ts https://raw.githubusercontent.com/kavispires/td-resources/main/types/tdr.ts",
    "sync:resources": "node scripts/sync-resources.cjs",
    "sync": "yarn sync:types && yarn sync:resources",
    "predeploy": "yarn sync && yarn build",
    "deploy": "gh-pages -d build",
    "lint": "biome check --staged --write --no-errors-on-unmatched",
    "clean": "rm -rf node_modules && yarn cache clean",
    "test": "vitest",
    "update-commit": "td amend-commit-date"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "biome check --staged --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.10.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-router-dom": "^5.3.3",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "vite-plugin-checker": "^0.13.0",
    "vitest": "^4.1.10"
  }
}
